#!/bin/sh
# Pre-commit hook: warn when code changes may need doc updates
# To enable: git config core.hooksPath githooks

STAGED_FILES=$(git diff --cached --name-only)
DOC_CHANGED=$(echo "$STAGED_FILES" | grep -E "^(README|AGENTS)\.md$")
CODE_CHANGED=$(echo "$STAGED_FILES" | grep -E "^(cmd/|pkg/|internal/|go\.mod)")

if [ -n "$CODE_CHANGED" ] && [ -z "$DOC_CHANGED" ]; then
    echo ""
    echo "⚠️  Code changes detected without doc updates."
    echo "   Consider updating README, AGENTS, or docs/ to reflect your changes."
    echo "   Staged:"
    echo "$CODE_CHANGED" | sed 's/^/     /'
    echo ""
    # Non-blocking: allow commit after 2s pause
    sleep 2
fi
