#!/bin/sh
# commit-msg hook: enforce Conventional Commits
# To enable: git config core.hooksPath githooks

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n1 "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|chore|refactor|docs|test|build|ci|perf|style|revert)(\(.+\))?!?: .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo ""
    echo "Invalid commit message format."
    echo ""
    echo "Commit message must follow Conventional Commits:"
    echo "  <type>[(scope)]: <description>"
    echo ""
    echo "Valid types: feat, fix, chore, refactor, docs, test, build, ci, perf, style, revert"
    echo ""
    echo "Example: feat(scanner): add Telegram cache support"
    echo ""
    exit 1
fi
